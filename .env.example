# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local (ni ningún .env con valores reales) a git.

# --- Supabase ---
# URL y llave pública (anon) del proyecto Supabase. Seguras para el cliente.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Llave de servicio (service_role). NUNCA debe exponerse al cliente.
# Solo se usa en Server Actions / Route Handlers / scripts server-side
# (import masivo, seed, tareas administrativas).
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# ID del proyecto (usado por la CLI de Supabase para link/migraciones).
SUPABASE_PROJECT_ID=TU_PROJECT_ID

# --- Resend (envío de emails) ---
RESEND_API_KEY=TU_RESEND_API_KEY
RESEND_FROM_EMAIL="Iglesia <notificaciones@tu-dominio.org>"

# --- Aplicación ---
# URL pública donde corre la app (usada en links de emails, QR, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto para firmar tokens de check-in QR de corta duración.
QR_CHECKIN_SECRET=genera-un-valor-aleatorio-largo-unico

# Ambiente: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# --- CAPTCHA (Cloudflare Turnstile) ---
# Login, registro, recuperar contraseña y la forma pública de inscripción.
# Sin site key el CAPTCHA no se muestra (solo desarrollo). En producción:
# ponlas en Vercel y la MISMA secret en Supabase → Authentication →
# Attack Protection → CAPTCHA (Turnstile). Ver docs/security.md §8.n.
# Claves de prueba de Cloudflare (siempre aprueban): site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
